# Allow auditing localhost / private-network hosts. Defaults to true in dev, false in production.
# ALLOW_PRIVATE_HOSTS=false

# Use a system Chromium instead of Playwright's bundled browser.
# CHROMIUM_PATH=/usr/bin/chromium

# Force the HTTP-only renderer (no browser; skips runtime and mobile layout checks).
# PILOTAUDIT_RENDERER=static

# Page limits per scan mode.
# QUICK_SCAN_MAX_PAGES=5
# FULL_SCAN_MAX_PAGES=20

# CLI only: post each daily Slack summary to this incoming webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
